{
  "name": "qc-dashboard-status",
  "version": "2.0.0",
  "private": true,
  "description": "Quay crane maintenance dashboard that reads the LIVE UPDATE Excel file.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "lint": "eslint src scripts tests",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/",
    "check": "npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "xlsx": "^0.18.5"
  }
}
